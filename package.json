{
  "name": "claude-pty-notify",
  "version": "0.1.0",
  "description": "Wraps Claude Code in a PTY and sends terminal notifications when it is waiting for input, without hooks",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
